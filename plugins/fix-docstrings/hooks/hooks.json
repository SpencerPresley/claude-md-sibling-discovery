{
  "description": "While fix-docstrings is active, injects LangChain's parsed-docstring rules only for files that explicitly enable `parse_docstring=True`, once per file and invocation.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": ".*fix-docstrings.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/langchain_tool_context.py\" trigger \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/langchain_tool_context.py\" trigger \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/langchain_tool_context.py\" detect \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/langchain_tool_context.py\" cleanup \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/langchain_tool_context.py\" cleanup \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
